# E-mail (SMTP Titan) — opcional; sem SMTP_USER/SMTP_PASS o envio fica "simulado"
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=propostas@iexprojetos.com
SMTP_PASS=
